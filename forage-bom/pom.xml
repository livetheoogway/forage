    </description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.livetheoogway.forage</groupId>
                <artifactId>forage-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.livetheoogway.forage</groupId>
                <artifactId>forage-models</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.livetheoogway.forage</groupId>
                <artifactId>forage-search-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.livetheoogway.forage</groupId>
                <artifactId>forage-dropwizard-bundle</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

</project>